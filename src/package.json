{
  "name": "zenodotus",
  "version": "0.1.0",
  "description": "A documentation indexer and browser",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "buildDev": "rimraf dist && webpack --mode development --config webpack.webserver.config.js",
    "buildDevFull": "rimraf dist && webpack --mode development --config webpack.webserver.config.js && webpack --mode development --config webpack.browser.dev.config.js",
    "start": "node ./dist/webserver.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brent-a/zenodotus.git"
  },
